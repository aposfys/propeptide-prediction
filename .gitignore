*.pt
*.pth
*.csv
__pycache__/
# Ignore environments and cache
.venv/
__pycache__/
.claude/
.DS_Store
**/.DS_Store

# Ignore large datasets and model weights
checkpoints/
embeddings/
baseline_*/
*.fasta
*.csv
*.csv.original
*.tsv
*.json

# Ignore logs
*.txt
*.pickle
train_run/
logs/

# --- Dependency manifests are source, not logs ---
# The blanket *.txt above otherwise silently ignores them, so a new
# requirements file looks committed but never is.
!requirements*.txt

# --- Results are the deliverable: re-include them ---
# The blanket *.json / *.csv rules above otherwise swallow every metrics and
# hyperparameter file, so a finished run would look empty to git and the
# supervisor would get code with no numbers attached. Model weights (*.pt) stay
# ignored — they are large and reproducible from the configs below.
!results/**/*.json
!results/**/*.csv

# TensorBoard event files are regenerable and can be large; the re-inclusions
# above would otherwise let them into results/ commits.
events.out.tfevents*

# Optuna study stores are resume state, not the deliverable: the trial history
# is already committed as results/**/optuna_trials_outer*.csv. No ignore rule
# above matches *.db, so without this they would land in results/ commits.
*.db
results/**/*.pickle
results/**/model.pt
results/**/*.pt

# --- The rebuilt dataset is source, not output ---
# The blanket *.csv / *.fasta / *.tsv / *.json rules above swallow data_v4/
# entirely, exactly as they would have swallowed results/. The published data/
# files escape only because they were tracked before those rules existed, which
# is why this needs saying rather than being inferred from the fact that data/
# works. A dataset that looks committed and is not is the worst failure mode
# here: every number in COVERAGE.md is computed from these files.
!data_v4/**/*.csv
!data_v4/*.csv
!data_v4/*.fasta
!data_v4/*.tsv
!data_v4/*.json
